# ─── MySQL ────────────────────────────────────────────────────────────────
# Bağlantı bilgileri. Veritabanı yoksa `npm run migrate` oluşturur.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cvmatch

# ─── Gemini ───────────────────────────────────────────────────────────────
# Google AI Studio'dan alınan API anahtarı. Boş bırakılırsa sistem
# heuristic (kural tabanlı) fallback ile çalışır; demo yine sonuç üretir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_ATTEMPTS=2
GEMINI_MIN_INTERVAL_MS=500
GEMINI_RETRY_MAX_DELAY_MS=8000

# ─── Arka plan crawler (kullanıcı akışında ÇALIŞMAZ) ───────────────────────
# Sadece `npm run crawl:jobs` ile cache doldurmak için kullanılır.
CRAWLER_FETCH_TIMEOUT_MS=8000
CRAWLER_FETCH_HARD_TIMEOUT_MS=20000
CRAWLER_MAX_SEARCH_URLS_PER_PLATFORM=2
CRAWLER_MAX_DETAILS_PER_PLATFORM=20
CRAWLER_MAX_CONCURRENT_PLATFORMS=3
CRAWLER_MAX_CONCURRENT_DETAILS=3
CRAWLER_PLATFORM_REQUEST_INTERVAL_MS=2000
CRAWLER_DEADLINE_MS=120000
# LinkedIn agresif anti-bot koruması nedeniyle varsayılan olarak kapalıdır.
CRAWLER_ENABLE_LINKEDIN=false

# ─── İş kuyruğu / worker ───────────────────────────────────────────────────
JOB_HEARTBEAT_MS=5000
JOB_SEARCH_TIMEOUT_MS=90000
JOB_STALE_PROCESSING_MINUTES=2

# ─── Verifier (ilan açık/kapalı kontrolü) ─────────────────────────────────
VERIFY_BATCH_SIZE=50
VERIFY_FETCH_TIMEOUT_MS=10000
VERIFY_STALE_AFTER_HOURS=12
VERIFY_EXPIRE_AFTER_DAYS=30
